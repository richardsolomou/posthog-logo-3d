#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

# dist/ is the site; build/ holds the downloads that CI publishes as a GitHub release.
rm -rf dist build
mkdir -p dist build
cp site/* src/posthog-logomark.svg dist/
node src/parts.mjs build
mv build/assembled.glb dist/
python3 -I bambu/build.py build build/posthog-logo.3mf
for f in build/*.stl; do mv "$f" "build/posthog-logo-$(basename "$f")"; done
