{
  "name": "posthog-logo-3d",
  "private": true,
  "description": "A 3D printable PostHog logo, split by color.",
  "homepage": "https://posthog-logo-3d.ras.sh",
  "license": "MIT",
  "author": {
    "name": "Richard Solomou",
    "email": "richard@solomou.dev",
    "url": "https://solomou.dev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/richardsolomou/posthog-logo-3d"
  },
  "type": "module",
  "scripts": {
    "build": "bin/build",
    "dev": "wrangler dev",
    "lint": "oxlint --type-aware --deny-warnings .",
