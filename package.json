    "fix": "pnpm format && oxlint --type-aware --fix .",
    "check": "pnpm format:check && pnpm lint"
  },
  "devDependencies": {
    "linkedom": "^0.18.13",
    "manifold-3d": "3.5.4",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2006",
    "ras-stack": "^6.0.0",
    "three": "^0.186.1",
    "wrangler": "^4.151.0"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@12.14.0"
}
